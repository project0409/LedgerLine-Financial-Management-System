# ==============================================================================
# LedgerLine Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables as required for your environment.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ledgerline_db
DB_USERNAME=ledger_user
DB_PASSWORD=ledger_secure_password_replace_me
DB_ROOT_PASSWORD=root_secure_password_replace_me

# Backend Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
# Secret must be at least 256 bits (32+ characters) for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
