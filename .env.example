# ==============================================================================
# LedgerLine Environment Configuration Template (.env.example)
#
# IMPORTANT NOTE FOR SPRING BOOT:
# Spring Boot does NOT automatically read a root .env file.
# You must set environment variables in your active shell or pass them to Maven:
#
# PowerShell Example:
#   $env:JWT_SECRET="404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970"
#   $env:DB_PASSWORD="ledger_secure_password_replace_me"
#
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Database Configuration (MySQL 8 - localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ledgerline_db
DB_USERNAME=ledger_user
DB_PASSWORD=ledger_secure_password_replace_me
DB_ROOT_PASSWORD=root_secure_password_replace_me

# Backend Application Configuration (http://localhost:8080)
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
# Required: Secret must be at least 256 bits (32+ characters) for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_SECURE=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration (Vite - http://localhost:5173)
# Leave empty to utilize the Vite development proxy (/api -> http://localhost:8080)
VITE_API_BASE_URL=
